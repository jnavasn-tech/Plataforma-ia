{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Salida de IA: diagnostico",
    "description": "Esquema validado por la plataforma (ValidadorRespuestaIA). Al proveedor se envía la versión estricta sin límites de longitud (EsquemasIA::formatoRespuesta).",
    "type": "object",
    "properties": {
        "resumen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
        },
        "fortalezas": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
            },
            "maxItems": 6
        },
        "areas_mejora": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
            },
            "maxItems": 6
        },
        "recomendacion_general": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
        }
    },
    "required": [
        "resumen",
        "fortalezas",
        "areas_mejora",
        "recomendacion_general"
    ],
    "additionalProperties": false
}
