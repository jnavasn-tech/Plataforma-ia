{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Salida de IA: retroalimentacion",
    "description": "Esquema validado por la plataforma (ValidadorRespuestaIA). Al proveedor se envía la versión estricta sin límites de longitud (EsquemasIA::formatoRespuesta).",
    "type": "object",
    "properties": {
        "mensaje": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
        },
        "sugerencias": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
            },
            "maxItems": 5
        },
        "siguiente_paso": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
        }
    },
    "required": [
        "mensaje",
        "sugerencias",
        "siguiente_paso"
    ],
    "additionalProperties": false
}
