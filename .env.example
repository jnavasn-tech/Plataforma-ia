# ------------------------------------------------------------------
# Plataforma web de diagnóstico y desarrollo de competencias informáticas
# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# ------------------------------------------------------------------
APP_NAME="Plataforma de Competencias IA"
APP_ENV=local
# Genere la clave con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Guatemala

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos MySQL 8 (en Docker el host es el servicio "db")
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=plataforma_competencias
DB_USERNAME=plataforma
DB_PASSWORD=
# Solo para el contenedor de MySQL (no se usa en la aplicación)
DB_ROOT_PASSWORD=
# Imagen de MySQL del contenedor db (8.0 según la línea base; 8.4 LTS recomendada, ver hallazgo H-24)
MYSQL_VERSION=8.0

CACHE_DRIVER=file
FILESYSTEM_DISK=local
# La cola procesa la interpretación del perfil y la generación de rutas (contenedor "cola")
QUEUE_CONNECTION=database

# Sesiones en base de datos: permiten cerrar sesiones en otros dispositivos (CU-08)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
# En producción con HTTPS debe ser true
SESSION_SECURE_COOKIE=false

# Correo (en desarrollo, Mailpit en http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Integración con IA (actor externo "API OpenAI")
# Si IA_HABILITADA=false o no hay clave, la plataforma usa reglas determinísticas (fallback).
# ------------------------------------------------------------------
IA_HABILITADA=true
IA_PROVEEDOR=openai
OPENAI_URL_BASE=https://api.openai.com/v1
# Clave privada: configúrela solo en el servidor; nunca en el código ni en capturas
OPENAI_API_KEY=
OPENAI_ORGANIZACION=
IA_MODELO=gpt-4o-mini
IA_TEMPERATURA=0.3
IA_MAX_TOKENS=1200
IA_TIMEOUT=15
IA_REINTENTOS=1
IA_ESPERA_REINTENTO_MS=500

# ------------------------------------------------------------------
# Parámetros funcionales (validar con expertos y Grupo Ilimitado, S. A.)
# ------------------------------------------------------------------
DIAGNOSTICO_ITEMS_POR_AREA=6
DIAGNOSTICO_HORAS_ABANDONO=72
NIVEL_UMBRAL_INTERMEDIO=50
NIVEL_UMBRAL_AVANZADO=80
RUTA_MAX_MODULOS=10
RUTA_ESPERA_MAXIMA_SEGUNDOS=120
EVALUACION_UMBRAL=70
EVALUACION_MAX_INTENTOS=3
RECURSOS_VERIFICAR_URL=true
RECURSOS_TIMEOUT_VERIFICACION=10
PRIVACIDAD_VERSION_AVISO=1.0

# Contraseñas de los usuarios ficticios de demostración (solo ambientes local/pruebas).
# Si se dejan vacías, el seeder genera contraseñas aleatorias y las muestra una vez.
DEMO_ADMIN_PASSWORD=
DEMO_ASPIRANTE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
